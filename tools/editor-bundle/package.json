{
  "name": "mdcraft-editor-bundle",
  "private": true,
  "description": "Builds web/vendor/codemirror/codemirror.min.js (CodeMirror 6 for mdcraft's editor pane). Run: npm install && npm run build",
  "scripts": {
    "build": "esbuild entry.js --bundle --minify --format=iife --global-name=CM --legal-comments=eof --outfile=../../crates/mdcraft-core/web/vendor/codemirror/codemirror.min.js"
  },
  "devDependencies": {
    "esbuild": "0.25.10"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/lang-javascript": "^6.2.0",
    "@codemirror/lang-python": "^6.1.0",
    "@codemirror/lang-json": "^6.0.0",
    "@codemirror/lang-css": "^6.3.0",
    "@codemirror/lang-html": "^6.4.0",
    "@codemirror/lang-rust": "^6.0.0",
    "@codemirror/lang-yaml": "^6.1.0",
    "@codemirror/lang-sql": "^6.8.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@lezer/highlight": "^1.2.0"
  }
}
